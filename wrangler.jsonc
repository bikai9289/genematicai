// Cloudflare Workers deploy config for genematicai.
// Secrets (AUTH_SECRET, CONFIG_ENCRYPTION_KEY) stay in the dashboard / wrangler secret — never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genematicai",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    { "pattern": "genematicai.com", "custom_domain": true },
    { "pattern": "www.genematicai.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://genematicai.com",
    "VITE_APP_NAME": "Genematic AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genematicai-db",
      "database_id": "ebcbcd3d-eaca-48ed-a9f1-8335952dbb4d",
    },
  ],
  "r2_buckets": [
    { "binding": "PRIVATE_MEDIA", "bucket_name": "genematicai-private-media" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROVIDER_GENERATE_RATE_LIMITER",
        "class_name": "ProviderGenerateRateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "provider-generate-rate-limiter-v1",
      "new_sqlite_classes": ["ProviderGenerateRateLimiter"],
    },
  ],
  "triggers": {
    "crons": ["0 16 * * *"],
  },
}
